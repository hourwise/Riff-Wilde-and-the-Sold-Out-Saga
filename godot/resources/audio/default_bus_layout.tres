[gd_resource type="AudioBusLayout" format=3]

; Bus tree:
;   Master
;   ├─ Music ──── MusicAmbient   (exploration bed)
;   │         ├── MusicCombat    (the four layered combat stems)
;   │         └── MusicBoss      (Choirmaster stems)
;   └─ SFX ────── SFXPlayer      (Riff: swings, footsteps, voice)
;             ├── SFXWorld       (enemies, altars, bell, ambience)
;             └── SFXUI          (menus, objective stingers)
;
; Combat stems all route through MusicCombat so the whole layered mix can be
; ducked or faded as one unit without disturbing the relative balance the
; composer set between layers.

[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"MusicAmbient"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Music"
bus/3/name = &"MusicCombat"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Music"
bus/4/name = &"MusicBoss"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = 0.0
bus/4/send = &"Music"
bus/5/name = &"SFX"
bus/5/solo = false
bus/5/mute = false
bus/5/bypass_fx = false
bus/5/volume_db = 0.0
bus/5/send = &"Master"
bus/6/name = &"SFXPlayer"
bus/6/solo = false
bus/6/mute = false
bus/6/bypass_fx = false
bus/6/volume_db = 0.0
bus/6/send = &"SFX"
bus/7/name = &"SFXWorld"
bus/7/solo = false
bus/7/mute = false
bus/7/bypass_fx = false
bus/7/volume_db = 0.0
bus/7/send = &"SFX"
bus/8/name = &"SFXUI"
bus/8/solo = false
bus/8/mute = false
bus/8/bypass_fx = false
bus/8/volume_db = 0.0
bus/8/send = &"SFX"
