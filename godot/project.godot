; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Riff Wilde and the Sold-Out Saga"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
SaveService="*res://scripts/autoload/SaveService.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
MusicDirector="*res://scripts/autoload/MusicDirector.gd"
ProgressionManager="*res://scripts/autoload/ProgressionManager.gd"
SceneLoader="*res://scripts/autoload/SceneLoader.gd"
UIRoot="*res://scripts/autoload/UIRoot.gd"
FirebaseConfig="*res://scripts/autoload/FirebaseConfig.gd"
CloudSyncService="*res://scripts/autoload/CloudSyncService.gd"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[filesystem]

import/blender/enabled=false

