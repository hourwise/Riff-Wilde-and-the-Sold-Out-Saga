[gd_scene load_steps=6 format=3 uid="uid://quaver_pickup"]

[ext_resource type="Script" path="res://scripts/world/Quaver.gd" id="1_quaver"]

[sub_resource type="SphereShape3D" id="Shape_pickup"]
radius = 0.4

; Warm gold, not spectral blue. The level is lit blue at night and everything
; hostile in it is blue as well — the Cantor's notes, the altar flames, the maze
; braziers — so a cyan pickup was both camouflaged and saying the wrong thing.
; Blue is danger here; a reward should be the one warm thing on screen.
[sub_resource type="StandardMaterial3D" id="Mat_note"]
transparency = 1
blend_mode = 1
shading_mode = 0
albedo_color = Color(1, 0.84, 0.42, 0.95)
emission_enabled = true
emission = Color(1, 0.78, 0.32, 1)
emission_energy_multiplier = 6.0

[sub_resource type="SphereMesh" id="Mesh_head"]
material = SubResource("Mat_note")
radius = 0.18
height = 0.36
radial_segments = 10
rings = 6

[sub_resource type="BoxMesh" id="Mesh_stem"]
material = SubResource("Mat_note")
size = Vector3(0.05, 0.58, 0.05)

; Layer 64 keeps pickups out of every combat and navigation query. It monitors
; nothing: collection is a distance check in the script, because an Area3D overlap
; would need the player to carry a matching body layer, and this should work in
; any test scene without one.
[node name="Quaver" type="Area3D"]
collision_layer = 64
collision_mask = 0
monitoring = false
script = ExtResource("1_quaver")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("Shape_pickup")

; A note: a head with a stem. Spun and bobbed by the script.
